{
  "name": "tokalo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "revisar": "wrangler types && tsc --noEmit",
    "desplegar": "wrangler deploy",
    "migrar:dev": "wrangler d1 migrations apply tokalo-dev --remote",
    "datos:dev": "wrangler d1 execute tokalo-dev --remote --file datos/prueba.sql",
    "desplegar:produccion": "wrangler deploy --env produccion",
    "migrar:produccion": "wrangler d1 migrations apply tokalo --env produccion --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.7.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
